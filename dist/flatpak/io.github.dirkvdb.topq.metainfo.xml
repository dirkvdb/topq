  <name>TopQ</name>
  <summary>Explore MQTT topics and messages</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.dirkvdb">
    <name>Dirk Vanden Boer</name>
